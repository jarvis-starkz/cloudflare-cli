# Cloudflare API Configuration
# Copy this file to .env and fill in your actual values

# Your Cloudflare Account ID (Required)
# Found at: https://dash.cloudflare.com -> Account Home -> Account ID
CLOUDFLARE_ACCOUNT_ID=your_account_id_here

# Your Cloudflare API Token (Required)
# Create at: https://dash.cloudflare.com/profile/api-tokens
# Required permissions: Zone.DNS, Zone.Settings, Zone, Account Settings
# ⚠ For better security, prefer storing credentials via `cfcli init` in OS Keychain.
CLOUDFLARE_API_TOKEN=your_api_token_here

# Your Cloudflare Zone ID (Required)
# Found at: https://dash.cloudflare.com -> Your Domain -> Zone ID (right sidebar)
CLOUDFLARE_ZONE_ID=your_zone_id_here

# Optional: API Base URL (default: https://api.cloudflare.com/client/v4)
CLOUDFLARE_API_BASE_URL=https://api.cloudflare.com/client/v4

# --------------------------------------------------------------
# cfcli credential store (P1 security enhancement)
# --------------------------------------------------------------
# auto   : Prefer OS Keychain (keytar) when available, fallback to AES-encrypted JSON file.
# keychain: Force OS Keychain only (error if keytar unavailable).
# file   : Force encrypted JSON file (store in config/credentials.enc.json).
CFCLI_CREDENTIAL_STORE=auto
CFCLI_KEYCHAIN_SERVICE=cfcli

# --------------------------------------------------------------
# R2 S3-compatible object credentials (P2 objects feature)
# Create R2 API tokens at:
#   https://dash.cloudflare.com/?to=/:account/r2/overview/api-tokens
# These are NOT the Cloudflare API Token — they are R2-specific Access/Secret keys.
# --------------------------------------------------------------
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=

# --------------------------------------------------------------
# Destructive-operation guard (CI/CD safety)
# When set to "1", deletes/bulk-deletes/cache purges run without
# the interactive TTY prompt. Default unset = requires explicit
# confirmation in TTY mode.
# --------------------------------------------------------------
# CFCLI_CONFIRM_DESTRUCTIVE=1
