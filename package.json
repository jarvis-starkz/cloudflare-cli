{
  "name": "cloudflare-cli",
  "version": "1.0.0",
  "description": "A comprehensive CLI tool for managing Cloudflare configurations",
  "main": "src/index.js",
  "bin": {
    "cfcli": "./src/index.js"
  },
  "types": "types/cf-client.d.ts",
  "scripts": {
    "start": "node src/index.js",
    "test": "jest --runInBand",
    "test:cov": "jest --runInBand --coverage",
    "gui": "node src/index.js gui",
    "tui": "node src/index.js tui",
    "registry": "node src/index.js commands json",
    "completion:bash": "node src/index.js completion bash",
    "completion:zsh": "node src/index.js completion zsh",
    "completion:fish": "node src/index.js completion fish",
    "completion:powershell": "node src/index.js completion powershell"
  },
  "keywords": [
    "cloudflare",
    "cli",
    "dns",
    "workers",
    "kv",
    "r2",
    "firewall",
    "ssl",
    "waf",
    "rulesets",
    "tui",
    "gui",
    "shell-completion",
    "multi-profile"
  ],
  "author": "Jarvis Zheng <jarvis_zheng@nc-s.hk>",
  "license": "MIT",
  "homepage": "https://github.com/jarvis-starkz/cloudflare-cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jarvis-starkz/cloudflare-cli.git"
  },
  "bugs": {
    "url": "https://github.com/jarvis-starkz/cloudflare-cli/issues"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.556.0",
    "@aws-sdk/s3-request-presigner": "^3.556.0",
    "axios": "^1.6.0",
    "axios-retry": "^3.9.0",
    "chalk": "^4.1.2",
    "commander": "^12.0.0",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.3.1",
    "inquirer": "^8.2.6",
    "ora": "^5.4.1",
    "pptxgenjs": "^4.0.1",
    "table": "^6.8.1"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "jest": "^29.7.0",
    "nock": "^13.5.4"
  },
  "optionalDependencies": {
    "keytar": "^7.9.0"
  },
  "engines": {
    "node": ">=14.17.0"
  }
}
